
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weather Station</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: #f5f5f5;
    display: flex;
    justify-content: center;
    padding: 40px 20px;
}

.wrapper {
    width: 100%;
    max-width: 700px;
}

h1 {
    text-align: center;
    margin-bottom: 25px;
    font-size: 32px;
    color: #333;
    font-weight: 600;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border: 2px solid #ccc;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

th, td {
    border: 1px solid #ccc;
    padding: 14px 12px;
    text-align: center;
    font-size: 16px;
}

thead th {
    background: #f0f0f0;
    font-weight: bold;
    color: #333;
}

/* Rowspan wale header ko center karna */
thead tr:first-child th {
    font-size: 17px;
}

tbody tr:nth-child(even) {
    background: #fafafa;
}

tbody tr:hover {
    background: #e8f4ff;
    transition: 0.2s;
}

/* Mobile ke liye responsive */
@media (max-width: 600px) {
    table {
        font-size: 14px;
    }
    th, td {
        padding: 10px 6px;
    }
    h1 {
        font-size: 24px;
    }
}
</style>
</head>
<body>

<div class="wrapper">
    <h1>Weather Station</h1>
    
    <table>
        <thead>
            <tr>
                <th rowspan="2">Station</th>
                <th colspan="2">Temperature</th>
                <th rowspan="2">Humidity</th>
                <th rowspan="2">Weather</th>
            </tr>
            <tr>
                <th>Min</th>
                <th>Max</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>USA</td>
                <td>24</td>
                <td>19</td>
                <td>60%</td>
                <td>Cloudy</td>
            </tr>
            <tr>
                <td>Germany</td>
                <td>5</td>
                <td>-1</td>
                <td>70%</td>
                <td>Rainy</td>
            </tr>
        </tbody>
    </table>
</div>

</body>
</html>